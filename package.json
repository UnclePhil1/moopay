{
  "name": "moopay",
  "version": "0.1.0",
  "description": "MooPay: private cross-chain payment agent as an MCP server (NEAR Intents 1Click + Chain Signatures)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "site": "node scripts/serve-site.mjs",
    "testnet": "tsx scripts/testnet-e2e.ts",
    "live-check": "tsx scripts/live-check.ts",
    "start:http": "node dist/http.js",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@near-wallet-selector/nightly": "10.1.4",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "util": "0.12.5"
  }
}
