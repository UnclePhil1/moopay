{
  "name": "moopay",
  "version": "0.1.0",
  "description": "NEAR Intents 1Click + Vanilla HTML/TypeScript Payment Engine",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.js",
    "start": "node dist/src/index.js",
    "test": "tsx --test tests/unit/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "site": "node scripts/serve-site.mjs",
    "testnet": "tsx scripts/testnet-e2e.ts",
    "live-check": "tsx scripts/live-check.ts",
    "stdio": "node dist/src/ai/mcp/stdio.js",
    "smoke:http": "tsx scripts/smoke-http.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@near-wallet-selector/nightly": "10.1.4",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@reown/appkit": "^1.8.24",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "util": "0.12.5"
  }
}
