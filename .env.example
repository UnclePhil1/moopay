# MooPay is non-custodial: there is no operator account and no private key to configure.
NEAR_NETWORK=mainnet
# Optional RPC override (default depends on NEAR_NETWORK).
# NEAR_RPC_URL=https://free.rpc.fastnear.com

# Chain Signatures MPC contract (docs: v1.signer). Not used on the NEAR-origin path.
MPC_CONTRACT_ID=v1.signer

# 1Click Swap API. Without a JWT every quote pays an extra 0.25% fee.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# public | basic | advanced (sent on the quote that pays out to the recipient).
ONECLICK_CONFIDENTIALITY=basic

# Local journal (commitments, nullifier hashes, status). Never secrets.
STATE_FILE=./moopay-state.json

# Agent chat (served at / by start:http). The AI is off without a key.
# AI brain. NEAR AI runs the chat inside sealed enclaves (private). If both keys are set, NEAR AI is used.
NEAR_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Default with NEAR AI: deepseek-ai/DeepSeek-V4.1-Flash-1017. Default with Anthropic: claude-sonnet-5-5.
AGENT_MODEL=

# Optional: pays the first small network fee for people who add money from other chains (no NEAR needed).
# A NEAR account you fund and its key, e.g. ed25519:... Keep it small; the per-day cap limits the cost.
GAS_SPONSOR_ACCOUNT=
GAS_SPONSOR_KEY=
GAS_SPONSOR_DAILY_MAX=
# Named wallets (name.<NAME_PARENT_ACCOUNT>). Off unless both are set.
NAME_PARENT_ACCOUNT=
NAME_PARENT_KEY=
NAME_DAILY_MAX=

# Hosting (Fly.io): listen on all addresses, and fix the public domain used in links
# MOOPAY_HOST=0.0.0.0
# MOOPAY_PUBLIC_HOST=https://moopay.cash
# Private route (beta): set to 1 to let users send USDC to a NEAR wallet through OutLayer's private balance.
# MOOPAY_PRIVATE_ROUTE=1
# MOOPAY_PRIVATE_ALL=1   # testing only: also allow other chains and coins (these failed in live tests)

# Encrypts the server seed files at rest. Keep a copy of this value somewhere safe and separate:
# without it the wallets can not be recovered. Generate one with: openssl rand -hex 32
# SEED_KEY=
# Set to 1 only behind Fly.io (reads the real client IP from fly-client-ip for rate limits)
# MOOPAY_TRUST_PROXY=1

# Limits (defaults shown). Chat older than this is deleted; AI messages allowed per day per user / per IP / in total.
# CHAT_RETENTION_DAYS=30
# AI_USER_DAILY=100
# AI_IP_DAILY=300
# AI_TOTAL_DAILY=5000

# Optional: where to send alerts (gas sponsor running low or being farmed, AI limit reached). A Slack or Discord webhook URL works.
# ALERT_WEBHOOK_URL=

# Free project id from https://dashboard.reown.com (public, not a secret). Lets phones pick any wallet to pay from, without opening MooPay inside a wallet app.
WALLETCONNECT_PROJECT_ID=

# Team-only numbers page at /stat. Off unless this is set; the browser asks for it (any user name).
MOOPAY_STAT_PASSWORD=
# A test run (your laptop) can report its payments to the real site's numbers page. Set the page's address here and the same password above.
# MOOPAY_STAT_REPORT_URL=https://moopay.cash/stat/ingest
# MOOPAY_ENV=development   # "production" or "development"; guessed from the host when not set

# The X agent: answers mentions of the MooPay account on X, in public. Off unless all six are set.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# X_BOT_USER_ID=        # the numeric id of the MooPay account on X
# X_BOT_HANDLE=moopay   # without the @
# X_POLL_SECONDS=30
# MOOPAY_FEE_ACCOUNT=   # NEAR wallet that receives the service fee (older name: MOOPAY_X_FEE_ACCOUNT); no fee when empty
# MOOPAY_CHAT_FEE_BPS=100  # 1% on sends, claims and stakes made in the MooPay chat
# MOOPAY_X_FEE_BPS=200     # 2% on the same made through X

# Optional: path token for the MCP connector over HTTP (24+ characters). Treat the full URL as a secret.
# MOOPAY_HTTP_TOKEN=
# Used by scripts/backup.mjs to encrypt state backups.
# BACKUP_KEY=

# ---- Security (all optional; the defaults are safe) ----
# A second AI checks every payment against what the user asked for. "off" turns it off. MOOPAY_AUDITOR_MODEL picks a cheaper model for it.
# MOOPAY_AUDITOR=on
# MOOPAY_AUDITOR_MODEL=
# Most one payment from the agent wallet may be, in dollars. Above it, the user pays from their own wallet.
# MOOPAY_TX_CEILING_USD=3000
# Most a payment started from X may be without approval in the app. A new recipient from X always needs approval.
# MOOPAY_X_AUTO_USD=10
# Pauses X payments by itself when more than this many money requests arrive in ten minutes.
# MOOPAY_X_BURST=30
# Turns on /admin/emergency-halt, /admin/resume and /admin/security-log. Use a long random value (24+ characters).
# MOOPAY_ADMIN_TOKEN=
